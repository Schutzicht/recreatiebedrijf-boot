---
interface Props { light?: boolean; }
const { light = false } = Astro.props;
const ink = light ? 'white' : 'var(--color-sea)';
const accent = light ? 'var(--color-amber)' : 'var(--color-coral)';
---
<a href="/" class="logo-mark inline-flex items-center gap-2.5" aria-label="Recreatiebedrijf Boot, naar home">
  <svg width="36" height="36" viewBox="0 0 40 40" fill="none" aria-hidden="true">
    <circle cx="20" cy="20" r="19" stroke={ink} stroke-width="1.4" opacity="0.4"/>
    <path d="M8 26c2.5-0.6 3.8-1.8 5-3.6 1.2 1.8 2.5 3 5 3.6 2.5-0.6 3.8-1.8 5-3.6 1.2 1.8 2.5 3 5 3.6 2.5-0.6 3.8-1.8 5-3.6" stroke={ink} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M14 22l6-10 6 10v2H14z" fill={accent}/>
    <circle cx="20" cy="14" r="1.6" fill={ink}/>
  </svg>
  <span class="leading-none">
    <span class="block text-[0.58rem] tracking-[0.22em] uppercase font-semibold" style={`color:${accent}`}>Sinds 1968</span>
    <span class="block text-[1.05rem] font-medium font-display tracking-tight" style={`color:${ink}; font-family: var(--font-display);`}>Recreatiebedrijf Boot</span>
  </span>
</a>
