---
interface Props {
  light?: boolean;
  size?: 'sm' | 'md' | 'lg';
}
const { light = false, size = 'md' } = Astro.props;
const heights = { sm: 28, md: 36, lg: 48 };
const h = heights[size];
---
<a href="/" class="logo-mark inline-flex items-center" aria-label="Recreatiebedrijf Boot, naar home">
  <img
    src="/recreatiebedrijf-boot-logo.png"
    alt="Recreatiebedrijf Boot"
    width={h * 2.78}
    height={h}
    style={`height: ${h}px; width: auto; ${light ? 'filter: brightness(0) invert(1);' : ''}`}
    loading="eager"
    decoding="async"
  />
</a>
