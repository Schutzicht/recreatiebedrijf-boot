---
interface Props {
  slug: string;
  name: string;
  short: string;
  capacity: string;
  sizeRange: string;
  priceFrom: string;
  eyebrow: string;
  image: string;
  badges?: string[];
  featured?: boolean;
}
const { slug, name, short, capacity, sizeRange, priceFrom, eyebrow, image, featured = false } = Astro.props;
---
<a
  href={`/accommodaties/${slug}`}
  class={`card card-hover group block p-0 overflow-hidden ${featured ? 'sm:grid sm:grid-cols-2 sm:items-stretch' : ''}`}
>
  <div class={`relative img-zoom bg-[var(--color-mist)] ${featured ? 'aspect-[4/3] sm:aspect-auto sm:min-h-[300px]' : 'aspect-[4/3]'}`}>
    <img src={image} alt={name} loading="lazy" class={featured ? 'sm:absolute sm:inset-0 w-full h-full object-cover' : ''} />
  </div>
  <div class={featured ? 'p-7 sm:p-9 flex flex-col justify-between' : 'p-6'}>
    <div>
      <div class="flex items-start justify-between gap-3">
        <span class="italic-display text-[var(--color-coral)] leading-tight"
              style={`font-size: ${featured ? '1.0625rem' : '0.9375rem'}; font-weight: 400;`}>{eyebrow}</span>
        <span class="chip chip-coral whitespace-nowrap">{priceFrom}</span>
      </div>
      <h3 class={`mt-1.5 font-display tracking-tight ${featured ? 'text-3xl sm:text-4xl' : 'text-2xl'}`}>{name}</h3>
      <p class={`mt-3 text-[var(--color-ink-soft)] ${featured ? 'text-base sm:text-lg leading-relaxed' : 'text-[15px] truncate-3'}`}>{short}</p>
    </div>

    <div class={featured ? 'mt-7' : 'mt-5'}>
      <div class="flex flex-wrap gap-1.5">
        <span class="chip chip-sand">{capacity}</span>
        <span class="chip chip-sand">{sizeRange}</span>
      </div>
      <div class="mt-5 flex items-center gap-2 text-sm font-semibold text-[var(--color-sea)] group-hover:text-[var(--color-coral)] transition-colors">
        {featured ? 'Bekijk dit verblijf' : 'Bekijk verblijf'}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
          <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>
  </div>
</a>
