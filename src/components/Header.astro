---
import Logo from './Logo.astro';
import { navigation } from '../data/site';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---
<header class="smart-header" data-scrolled="false">
  <div class="container-x">
    <div id="header-inner" class="flex items-center justify-between py-4">
      <Logo />

      <nav class="hidden lg:flex items-center gap-1" aria-label="Hoofdmenu">
        {navigation.map(item => (
          item.children ? (
            <div class="relative group">
              <a href={item.href} class="nav-link" data-active={isActive(item.href)}>
                {item.label}
                <svg class="ml-1 opacity-60" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                  <path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
              </a>
              <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <div class="bg-white rounded-2xl shadow-[0_20px_50px_-12px_rgba(20,57,69,0.22)] border border-[var(--color-line-soft)] p-2 min-w-[320px]">
                  {item.children.map(c => (
                    <a href={c.href} class="block px-4 py-3 rounded-xl hover:bg-[var(--color-mist)] transition-colors">
                      <span class="block text-sm font-semibold text-[var(--color-sea-deep)]">{c.label}</span>
                      <span class="block text-[13px] text-[var(--color-ink-mute)] mt-0.5">{c.desc}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a href={item.href} class="nav-link" data-active={isActive(item.href)}>{item.label}</a>
          )
        ))}
      </nav>

      <div class="hidden lg:flex items-center gap-2.5">
        <a href="/reserveren" class="btn btn-coral btn-sm">Reserveren</a>
      </div>

      <button
        class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-full border border-[var(--color-line)] bg-white/80 backdrop-blur text-[var(--color-sea-deep)]"
        data-menu-toggle
        type="button"
        aria-label="Menu openen"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu, buiten de header voor schone z-index stacking -->
<div id="mobile-menu" class="mobile-menu lg:hidden" data-mobile-menu data-open="false" aria-hidden="true">
  <div class="mobile-menu__backdrop" data-menu-close></div>

  <aside class="mobile-menu__panel" aria-label="Mobiele navigatie">
    <div class="mobile-menu__header">
      <Logo />
      <button
        class="w-10 h-10 rounded-full border border-[var(--color-line)] inline-flex items-center justify-center text-[var(--color-sea-deep)] hover:bg-[var(--color-mist)] transition-colors"
        data-menu-close
        type="button"
        aria-label="Menu sluiten"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
          <path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <nav class="mobile-menu__nav" aria-label="Mobiel hoofdmenu">
      {navigation.map(item => (
        <div class="mobile-menu__group">
          <a
            href={item.href}
            class="mobile-menu__link"
            data-active={isActive(item.href)}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="mobile-menu__sublinks">
              {item.children.map(c => (
                <a href={c.href} class="mobile-menu__sublink">
                  {c.label}
                  <span class="mobile-menu__subdesc">{c.desc}</span>
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="mobile-menu__cta">
      <a href="/reserveren" class="btn btn-coral btn-lg w-full">Reserveren</a>
      <a href="/contact" class="btn btn-outline w-full mt-2">Contact</a>
    </div>
  </aside>
</div>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    visibility: hidden;
    pointer-events: none;
  }
  .mobile-menu[data-open="true"] {
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-menu__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 57, 69, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 280ms ease;
    cursor: pointer;
  }
  .mobile-menu[data-open="true"] .mobile-menu__backdrop {
    opacity: 1;
  }

  .mobile-menu__panel {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: min(88vw, 400px);
    background: var(--color-paper);
    box-shadow: -24px 0 60px -16px rgba(20, 57, 69, 0.40);
    transform: translateX(100%);
    transition: transform 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
  }
  .mobile-menu[data-open="true"] .mobile-menu__panel {
    transform: translateX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu__backdrop,
    .mobile-menu__panel { transition: none; }
  }

  .mobile-menu__header {
    flex-shrink: 0;
    padding: 1.125rem 1.25rem;
    border-bottom: 1px solid var(--color-line);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mobile-menu__nav {
    flex: 1;
    padding: 1rem 0.875rem;
  }

  .mobile-menu__group {
    margin-bottom: 0.25rem;
  }

  .mobile-menu__link {
    display: block;
    padding: 0.875rem 1rem;
    border-radius: 12px;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-sea-deep);
    transition: background-color 160ms ease, color 160ms ease;
  }
  .mobile-menu__link:hover,
  .mobile-menu__link[data-active="true"] {
    background: var(--color-mist);
    color: var(--color-sea-deep);
  }

  .mobile-menu__sublinks {
    margin: 0.125rem 0 0.5rem 1rem;
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-line);
  }

  .mobile-menu__sublink {
    display: block;
    padding: 0.625rem 0.875rem;
    border-radius: 10px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
    transition: background-color 160ms ease;
  }
  .mobile-menu__sublink:hover {
    background: var(--color-sand-soft);
  }
  .mobile-menu__subdesc {
    display: block;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-ink-mute);
    margin-top: 1px;
  }

  .mobile-menu__cta {
    flex-shrink: 0;
    padding: 1.125rem 1.25rem 1.5rem;
    border-top: 1px solid var(--color-line);
    background: var(--color-paper);
    position: sticky;
    bottom: 0;
  }
</style>

<script is:inline>
  (() => {
    const menu = document.querySelector('[data-mobile-menu]');
    if (!menu) return;

    const toggles = document.querySelectorAll('[data-menu-toggle]');
    const closers = menu.querySelectorAll('[data-menu-close]');
    const links = menu.querySelectorAll('a');

    function open() {
      menu.setAttribute('data-open', 'true');
      menu.setAttribute('aria-hidden', 'false');
      toggles.forEach(t => t.setAttribute('aria-expanded', 'true'));
      document.body.style.overflow = 'hidden';
    }
    function close() {
      menu.setAttribute('data-open', 'false');
      menu.setAttribute('aria-hidden', 'true');
      toggles.forEach(t => t.setAttribute('aria-expanded', 'false'));
      document.body.style.overflow = '';
    }
    function toggle() {
      if (menu.getAttribute('data-open') === 'true') close();
      else open();
    }

    toggles.forEach(t => t.addEventListener('click', toggle));
    closers.forEach(c => c.addEventListener('click', close));
    links.forEach(a => a.addEventListener('click', () => {
      // Sluit menu na navigeren naar pagina-link (niet voor de close-knop, die zit in closers)
      close();
    }));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.getAttribute('data-open') === 'true') close();
    });
  })();
</script>
