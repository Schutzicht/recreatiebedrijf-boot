---
import Logo from './Logo.astro';
import { navigation } from '../data/site';

interface Props {
  currentPath: string;
}
const { currentPath } = Astro.props;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---
<header class="smart-header" data-scrolled="false">
  <div class="container-x">
    <div id="header-inner" class="flex items-center justify-between py-4">
      <Logo />

      <nav class="hidden lg:flex items-center gap-1" aria-label="Hoofdmenu">
        {navigation.map(item => (
          item.children ? (
            <div class="relative group">
              <a href={item.href} class="nav-link" data-active={isActive(item.href)}>
                {item.label}
                <svg class="ml-1 opacity-60" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                  <path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                </svg>
              </a>
              <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <div class="bg-white rounded-2xl shadow-[0_20px_50px_-12px_rgba(20,57,69,0.22)] border border-[var(--color-line-soft)] p-2 min-w-[320px]">
                  {item.children.map(c => (
                    <a href={c.href} class="block px-4 py-3 rounded-xl hover:bg-[var(--color-mist)] transition-colors">
                      <span class="block text-sm font-semibold text-[var(--color-sea-deep)]">{c.label}</span>
                      <span class="block text-[13px] text-[var(--color-ink-mute)] mt-0.5">{c.desc}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a href={item.href} class="nav-link" data-active={isActive(item.href)}>{item.label}</a>
          )
        ))}
      </nav>

      <div class="hidden lg:flex items-center gap-2.5">
        <a href="/reserveren" class="btn btn-coral btn-sm">Reserveren</a>
      </div>

      <button
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-full border border-[var(--color-line)] bg-white/80 backdrop-blur"
        data-menu-toggle
        aria-label="Menu openen"
        aria-expanded="false"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M3 5h12M3 9h12M3 13h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="lg:hidden fixed inset-0 z-50 pointer-events-none" data-mobile-menu data-open="false">
    <div class="absolute inset-0 bg-[var(--color-sea-deep)]/60 backdrop-blur-sm transition-opacity duration-300 opacity-0 [[data-open=true]_>_&]:opacity-100" style="opacity: var(--menu-bg, 0)"></div>
    <div class="absolute right-0 top-0 bottom-0 w-[88%] max-w-[380px] bg-[var(--color-paper)] shadow-2xl translate-x-full transition-transform duration-300 [[data-open=true]_>_&]:translate-x-0 overflow-y-auto pointer-events-auto" style="transform: var(--menu-x, translateX(100%))">
      <div class="px-6 py-5 border-b border-[var(--color-line)] flex items-center justify-between">
        <Logo />
        <button class="w-9 h-9 rounded-full border border-[var(--color-line)] inline-flex items-center justify-center" data-menu-toggle aria-label="Menu sluiten">
          <svg width="14" height="14" viewBox="0 0 14 14"><path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>
      </div>
      <nav class="p-4" aria-label="Mobiel menu">
        {navigation.map(item => (
          <div class="mb-1">
            <a href={item.href} class="block px-4 py-3 rounded-xl text-base font-medium hover:bg-[var(--color-mist)] text-[var(--color-sea-deep)]" data-active={isActive(item.href)}>
              {item.label}
            </a>
            {item.children && (
              <div class="ml-3 pl-3 border-l border-[var(--color-line)] my-1">
                {item.children.map(c => (
                  <a href={c.href} class="block px-3 py-2 text-[15px] text-[var(--color-ink-soft)] hover:text-[var(--color-sea)] transition-colors">
                    {c.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
        <div class="px-4 mt-4">
          <a href="/reserveren" class="btn btn-coral w-full">Reserveren</a>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  [data-mobile-menu][data-open="true"] {
    pointer-events: auto;
  }
  [data-mobile-menu][data-open="true"] > div:first-child {
    opacity: 1 !important;
  }
  [data-mobile-menu][data-open="true"] > div:last-child {
    transform: translateX(0) !important;
  }
</style>
