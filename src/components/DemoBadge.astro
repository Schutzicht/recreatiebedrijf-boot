---
// Permanent demo-badge zichtbaar op iedere pagina. Klikbaar om de splash opnieuw te tonen.
---
<button type="button" class="demo-badge" data-demo-show aria-label="Demo-info opnieuw bekijken">
  <span class="demo-badge-dot"></span>
  <span class="demo-badge-label">Demo</span>
  <span class="demo-badge-info">Info</span>
</button>

<style>
  .demo-badge {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 35;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem 0.5rem 0.75rem;
    background: rgba(20, 57, 69, 0.92);
    color: white;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 32px -10px rgba(20, 57, 69, 0.45);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 200ms ease, background-color 200ms ease, padding 200ms ease;
  }
  .demo-badge:hover {
    background: var(--color-coral);
    transform: translateY(-1px);
  }
  .demo-badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-amber);
    flex-shrink: 0;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-amber) 25%, transparent);
    animation: demo-badge-pulse 1.8s ease-in-out infinite;
  }
  @keyframes demo-badge-pulse {
    0%, 100% { box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-amber) 25%, transparent); }
    50%      { box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-amber) 0%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-badge-dot { animation: none; }
  }
  .demo-badge-label {
    line-height: 1;
  }
  .demo-badge-info {
    line-height: 1;
    opacity: 0.6;
    border-left: 1px solid rgba(255, 255, 255, 0.18);
    padding-left: 0.625rem;
  }
  .demo-badge:hover .demo-badge-info { opacity: 1; }

  @media (max-width: 640px) {
    .demo-badge { left: 0.75rem; bottom: 0.75rem; }
    .demo-badge-info { display: none; }
  }
</style>

<script is:inline>
  (() => {
    const btn = document.querySelector('[data-demo-show]');
    if (!btn) return;
    btn.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('demo:show'));
    });
  })();
</script>
