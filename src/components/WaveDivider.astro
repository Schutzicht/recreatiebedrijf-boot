---
interface Props {
  color?: string;
  bg?: string;
  flip?: boolean;
}
const { color = 'var(--color-coral)', bg = 'transparent', flip = false } = Astro.props;
---
<div class="wave-divider" style={`background: ${bg};`}>
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" aria-hidden="true" style={flip ? 'transform: scaleY(-1)' : ''}>
    <!-- Hand-drawn coastal wave: one organic curve with subtle imperfections -->
    <path
      d="M0 32 C 90 12, 180 50, 280 28 S 460 8, 560 32 S 740 56, 840 30 S 1010 6, 1110 30 S 1290 54, 1390 28 L 1440 28"
      fill="none"
      stroke={color}
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.55"
    />
    <path
      d="M0 38 C 110 22, 200 56, 300 36 S 480 18, 580 40 S 760 60, 860 38 S 1030 16, 1130 38 S 1310 60, 1410 36 L 1440 36"
      fill="none"
      stroke={color}
      stroke-width="0.9"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.30"
    />
  </svg>
</div>

<style>
  .wave-divider {
    width: 100%;
    line-height: 0;
    overflow: hidden;
  }
  .wave-divider svg {
    display: block;
    width: 100%;
    height: 36px;
  }
  @media (min-width: 640px) {
    .wave-divider svg { height: 44px; }
  }
  @media (min-width: 1024px) {
    .wave-divider svg { height: 56px; }
  }
</style>
