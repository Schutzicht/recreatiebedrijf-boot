---
// Splash overlay shown on first visit (and re-openable via DemoBadge).
// Persistence via localStorage key `boot-demo-acknowledged`.
---
<div class="demo-splash" data-demo-splash hidden aria-hidden="true">
  <div class="demo-splash-backdrop" data-demo-close></div>

  <div class="demo-splash-card" role="dialog" aria-labelledby="demo-splash-title" aria-modal="true">
    <button type="button" class="demo-splash-close" data-demo-close aria-label="Sluit demo-introductie">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
        <path d="M3 3l8 8M11 3l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>

    <div class="demo-splash-eyebrow">
      <span class="demo-splash-dot"></span>
      Demo-versie
    </div>

    <h2 id="demo-splash-title" class="demo-splash-title">
      Welkom bij een <em>voorproefje</em>.
    </h2>

    <p class="demo-splash-intro">
      Je kijkt naar een eerste demo van hoe de nieuwe website van Recreatiebedrijf Boot eruit kan komen te zien. Bedoeld om akkoord op te krijgen, niet om live te gaan.
    </p>

    <ul class="demo-splash-list">
      <li>
        <span class="demo-splash-num">01</span>
        <div>
          <strong>Teksten zijn proef-content</strong>
          <span>Geschreven om de toon en structuur te tonen, niet definitief.</span>
        </div>
      </li>
      <li>
        <span class="demo-splash-num">02</span>
        <div>
          <strong>Foto's komen van de huidige site</strong>
          <span>Nieuw beeldmateriaal volgt na akkoord op de demo.</span>
        </div>
      </li>
      <li>
        <span class="demo-splash-num">03</span>
        <div>
          <strong>Boekingsformulieren zijn nog niet gekoppeld</strong>
          <span>De flow is ingericht zodat je ziet hoe het werkt; daadwerkelijke koppeling volgt.</span>
        </div>
      </li>
      <li>
        <span class="demo-splash-num">04</span>
        <div>
          <strong>Kleuren, lettertype en menu kunnen wijzigen</strong>
          <span>De richting staat, details bepalen we samen verder.</span>
        </div>
      </li>
    </ul>

    <div class="demo-splash-actions">
      <button type="button" class="btn btn-coral btn-lg" data-demo-enter>Bekijk de demo</button>
      <span class="demo-splash-meta">Gebouwd voor Gertjan &amp; Lisette</span>
    </div>

    <div class="demo-splash-foot">
      <svg width="24" height="24" viewBox="0 0 40 40" fill="none" aria-hidden="true">
        <circle cx="20" cy="20" r="19" stroke="var(--color-sea)" stroke-width="1.4" opacity="0.4"/>
        <path d="M8 26c2.5-0.6 3.8-1.8 5-3.6 1.2 1.8 2.5 3 5 3.6 2.5-0.6 3.8-1.8 5-3.6 1.2 1.8 2.5 3 5 3.6 2.5-0.6 3.8-1.8 5-3.6" stroke="var(--color-sea)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M14 22l6-10 6 10v2H14z" fill="var(--color-coral)"/>
        <circle cx="20" cy="14" r="1.6" fill="var(--color-sea)"/>
      </svg>
      <span>Recreatiebedrijf Boot · Noordwelle · Schouwen-Duiveland</span>
    </div>
  </div>
</div>

<style>
  .demo-splash {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity 320ms ease;
  }
  .demo-splash[data-show="true"] {
    opacity: 1;
    pointer-events: auto;
  }
  .demo-splash[hidden] { display: none; }

  .demo-splash-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 57, 69, 0.55);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .demo-splash-card {
    position: relative;
    width: 100%;
    max-width: 640px;
    margin: auto;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    border-radius: 22px;
    padding: 2rem 1.625rem;
    box-shadow:
      0 1px 0 rgba(255,255,255,0.6) inset,
      0 30px 80px -20px rgba(20, 57, 69, 0.5),
      0 8px 24px -8px rgba(20, 57, 69, 0.3);
    transform: translateY(8px) scale(0.98);
    opacity: 0;
    transition: transform 360ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 280ms ease 80ms;
  }
  @media (min-width: 640px) {
    .demo-splash-card { padding: 2.5rem; }
  }
  .demo-splash[data-show="true"] .demo-splash-card {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  .demo-splash-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: white;
    border: 1px solid var(--color-line);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition: all 180ms ease;
  }
  .demo-splash-close:hover {
    color: var(--color-coral);
    border-color: var(--color-coral);
    transform: rotate(90deg);
  }

  .demo-splash-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-coral);
    margin-bottom: 1.25rem;
  }
  .demo-splash-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-coral);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-coral) 18%, transparent);
    animation: demo-pulse 1.6s ease-in-out infinite;
  }
  @keyframes demo-pulse {
    0%, 100% { box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-coral) 18%, transparent); }
    50%      { box-shadow: 0 0 0 8px color-mix(in srgb, var(--color-coral) 0%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-splash-dot { animation: none; }
  }

  .demo-splash-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0;
    text-wrap: balance;
  }
  .demo-splash-title em {
    font-style: italic;
    color: var(--color-coral);
    font-weight: 500;
  }

  .demo-splash-intro {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
    max-width: 52ch;
  }
  @media (min-width: 640px) {
    .demo-splash-intro { font-size: 1rem; }
  }

  .demo-splash-list {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .demo-splash-list { gap: 0.875rem; }
  }
  .demo-splash-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.75rem 0.875rem;
    background: white;
    border: 1px solid var(--color-line-soft);
    border-radius: 12px;
  }
  .demo-splash-num {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-coral);
    background: color-mix(in srgb, var(--color-coral) 8%, white);
    border: 1px solid color-mix(in srgb, var(--color-coral) 22%, transparent);
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .demo-splash-list strong {
    display: block;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-sea-deep);
    line-height: 1.35;
  }
  .demo-splash-list span {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-ink-mute);
    margin-top: 2px;
    line-height: 1.45;
  }

  .demo-splash-actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .demo-splash-meta {
    font-family: var(--font-script);
    font-size: 1.125rem;
    color: var(--color-ink-mute);
  }

  .demo-splash-foot {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--color-line);
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.75rem;
    color: var(--color-ink-mute);
    letter-spacing: 0.02em;
  }
</style>

<script is:inline>
  (() => {
    const KEY = 'boot-demo-acknowledged';
    const splash = document.querySelector('[data-demo-splash]');
    if (!splash) return;

    const enterBtn = splash.querySelector('[data-demo-enter]');
    const closeEls = splash.querySelectorAll('[data-demo-close]');

    function show() {
      splash.removeAttribute('hidden');
      splash.setAttribute('aria-hidden', 'false');
      // double rAF zorgt voor zachte fade-in nadat hidden weg is
      requestAnimationFrame(() => {
        requestAnimationFrame(() => splash.setAttribute('data-show', 'true'));
      });
      document.body.style.overflow = 'hidden';
    }
    function hide(remember) {
      splash.removeAttribute('data-show');
      splash.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (remember) {
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
      }
      setTimeout(() => splash.setAttribute('hidden', ''), 360);
    }

    let acknowledged = false;
    try { acknowledged = localStorage.getItem(KEY) === '1'; } catch (e) {}
    if (!acknowledged) show();

    if (enterBtn) enterBtn.addEventListener('click', () => hide(true));
    closeEls.forEach(el => el.addEventListener('click', () => hide(true)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && splash.getAttribute('data-show') === 'true') hide(true);
    });

    // Externe trigger via badge
    document.addEventListener('demo:show', () => show());
  })();
</script>
