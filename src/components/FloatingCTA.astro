---
// Floating reserveer-knop, alleen op mobiel.
// Verschijnt pas wanneer de gebruiker voorbij de hero is gescrold.
// Verbergt zich op de /reserveren pagina zelf.
const path = Astro.url.pathname;
const onReserveren = path === '/reserveren' || path.startsWith('/reserveren/');
---
{!onReserveren && (
  <a
    href="/reserveren"
    class="floating-cta lg:hidden"
    data-floating-cta
    data-show="false"
    aria-label="Naar reserveringspagina"
  >
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="2" y="3.5" width="12" height="10.5" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
      <path d="M5 1.5v3M11 1.5v3M2 7h12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
    <span>Reserveer</span>
  </a>
)}

<style>
  .floating-cta {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 30;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8125rem 1.25rem;
    border-radius: 999px;
    background: var(--color-coral);
    color: white;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1;
    border: 1px solid color-mix(in srgb, white 12%, transparent);
    box-shadow:
      0 1px 0 rgba(255,255,255,0.18) inset,
      0 16px 40px -10px rgba(201, 95, 58, 0.6),
      0 4px 12px -4px rgba(20, 57, 69, 0.25);
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px) scale(0.96);
    transition: opacity 280ms ease, transform 280ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .floating-cta[data-show="true"] {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }
  .floating-cta:hover {
    background: var(--color-coral-deep);
  }
  .floating-cta:active {
    transform: translateY(0) scale(0.98);
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-cta { transition: opacity 200ms ease; }
  }
</style>

<script is:inline>
  (() => {
    const cta = document.querySelector('[data-floating-cta]');
    if (!cta) return;

    function update() {
      // Toon pas wanneer de eerste viewport voorbij is.
      // Drempel: 70% van de viewport-hoogte zodat hero echt uit beeld is.
      const threshold = window.innerHeight * 0.7;
      const past = window.scrollY > threshold;
      cta.setAttribute('data-show', past ? 'true' : 'false');
    }

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  })();
</script>
