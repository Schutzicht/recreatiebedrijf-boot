---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const bikes = [
  { name: 'Stadsfiets', price: '€ 12 p.d.', desc: 'Comfortabele fiets voor dagtochten naar Renesse en het strand.' },
  { name: 'E-bike', price: '€ 22 p.d.', desc: 'Voor wie verder wil verkennen of op zoek is naar wat ondersteuning.' },
  { name: 'Kinderfiets', price: '€ 8 p.d.', desc: 'Diverse maten, vanaf 4 jaar.' },
  { name: 'Aanhanger / kinderzitje', price: '€ 5 p.d.', desc: 'Veilig onderweg met de allerkleinsten.' },
];
---
<Layout title="Fietsverhuur" description="Fietsen huren via Died's Fiets, bezorging op de camping inbegrepen.">
  <PageHero
    eyebrow="Samen met Died's Fiets"
    title="Fietsverhuur, bezorgd op de camping."
    description="Eigen fiets vergeten of gewoon zin in een e-bike? Wij regelen alles in samenwerking met Died's Fiets. Reserveren via de receptie of vooraf per mail."
    image="/images/fietsverhuur.webp"
  />

  <section class="section">
    <div class="container-x">
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-7" data-reveal>
          <h2 class="heading-lg text-balance">Tarieven</h2>
          <p class="mt-3 text-[var(--color-ink-soft)] max-w-xl">
            Indicatieve prijzen. Definitieve tarieven en beschikbaarheid lopen via Died's Fiets.
          </p>

          <div class="mt-8 divide-y divide-[var(--color-line)] border-t border-b border-[var(--color-line)]">
            {bikes.map(b => (
              <div class="py-5 grid sm:grid-cols-3 gap-3 items-center">
                <div class="font-display text-lg text-[var(--color-sea-deep)]">{b.name}</div>
                <div class="text-[15px] text-[var(--color-ink-soft)]">{b.desc}</div>
                <div class="text-right">
                  <span class="chip chip-coral">{b.price}</span>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-10 grid sm:grid-cols-2 gap-5">
            <div class="card card-elev">
              <div class="text-xs uppercase tracking-wider font-semibold text-[var(--color-coral)]">Bezorging</div>
              <h3 class="text-lg font-display mt-1.5">Op de camping</h3>
              <p class="mt-2 text-sm text-[var(--color-ink-soft)]">De fietsen worden bezorgd bij je accommodatie en weer opgehaald.</p>
            </div>
            <div class="card card-elev">
              <div class="text-xs uppercase tracking-wider font-semibold text-[var(--color-coral)]">Reserveren</div>
              <h3 class="text-lg font-display mt-1.5">Vooraf of ter plekke</h3>
              <p class="mt-2 text-sm text-[var(--color-ink-soft)]">In het hoogseizoen aanrader: reserveer vooraf via de receptie of per mail.</p>
            </div>
          </div>
        </div>

        <aside class="lg:col-span-5" data-reveal>
          <div class="card card-elev p-7 lg:sticky lg:top-28">
            <h3 class="text-xl font-display">Reserveer een fiets</h3>
            <p class="mt-2 text-sm text-[var(--color-ink-mute)]">Stuur een bericht en wij regelen de rest.</p>

            <form class="mt-5 space-y-4">
              <div>
                <label class="field-label" for="name">Naam</label>
                <input id="name" type="text" class="field" placeholder="Jouw naam"/>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="field-label" for="from">Van</label>
                  <input id="from" type="date" class="field"/>
                </div>
                <div>
                  <label class="field-label" for="to">Tot</label>
                  <input id="to" type="date" class="field"/>
                </div>
              </div>
              <div>
                <label class="field-label" for="bikes">Type fiets</label>
                <select id="bikes" class="field">
                  <option>Stadsfiets</option>
                  <option>E-bike</option>
                  <option>Kinderfiets</option>
                  <option>Aanhanger / kinderzitje</option>
                </select>
              </div>
              <button type="button" class="btn btn-coral w-full" data-mailto="info@recreatiebedrijfboot.nl" data-subject="Aanvraag fietsverhuur via website">Verstuur aanvraag</button>
            </form>
            <p class="mt-3 text-[11px] text-[var(--color-ink-mute)] text-center">
              Je aanvraag komt bij de receptie binnen; wij regelen het met Died's Fiets en bevestigen naar je terug.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>
