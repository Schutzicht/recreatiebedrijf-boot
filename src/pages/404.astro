---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Pagina niet gevonden">
  <section class="min-h-[70vh] flex items-center bg-mesh-warm">
    <div class="container-x text-center max-w-2xl mx-auto" data-reveal>
      <span class="eyebrow mb-5 mx-auto">404</span>
      <h1 class="text-5xl lg:text-6xl text-balance">Deze pagina is even van het pad af.</h1>
      <p class="mt-5 text-lg text-[var(--color-ink-soft)]">Geen probleem, vind je weg snel terug naar onze homepage.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn btn-coral btn-lg">Naar de home</a>
        <a href="/accommodaties" class="btn btn-outline btn-lg">Bekijk verblijven</a>
      </div>
    </div>
  </section>
</Layout>
