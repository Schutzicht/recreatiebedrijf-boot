---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Broodjesservice" description="Bestel verse broodjes en croissants en haal ze 's ochtends op bij de receptie.">
  <PageHero
    eyebrow="'s Ochtends warm op tafel"
    title="Broodjesservice"
    description="Bestel de avond ervoor en haal de volgende ochtend warm brood, croissants en gevulde koeken op bij de receptie. Een echte vakantieklassieker bij Boot."
  />

  <section class="section">
    <div class="container-x">
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-7" data-reveal>
          <h2 class="text-3xl lg:text-4xl text-balance">Hoe het werkt</h2>
          <ol class="mt-6 space-y-5">
            {[
              ['Bestel voor 18:00', 'Vul de avond ervoor de bestellijst in op de receptie of stuur een appje.'],
              ['Wij bakken vroeg op', 'Onze lokale bakker zorgt dat alles vroeg klaar is.'],
              ['Haal op bij de receptie', 'Vanaf 08:00 staat alles voor je klaar, netjes per accommodatie ingepakt.'],
            ].map((s, i) => (
              <li class="flex items-start gap-5">
                <span class="shrink-0 w-9 h-9 rounded-full bg-[var(--color-coral)] text-white flex items-center justify-center font-display font-medium">{i + 1}</span>
                <div>
                  <div class="text-lg font-display text-[var(--color-sea-deep)]">{s[0]}</div>
                  <div class="text-[15px] text-[var(--color-ink-soft)] mt-1">{s[1]}</div>
                </div>
              </li>
            ))}
          </ol>

          <h3 class="text-xl font-display mt-12 mb-5">Wat je kunt bestellen</h3>
          <div class="grid sm:grid-cols-2 gap-3">
            {[
              ['Wit puntje', '€ 0,80'],
              ['Bruin puntje', '€ 0,90'],
              ['Croissant', '€ 1,30'],
              ['Boerenwit', '€ 3,50'],
              ['Volkoren', '€ 3,80'],
              ['Krentenbol', '€ 1,10'],
              ['Gevulde koek', '€ 2,40'],
              ['Worstenbroodje', '€ 2,80'],
            ].map(([item, price]) => (
              <div class="flex items-center justify-between p-4 rounded-xl border border-[var(--color-line)] bg-white">
                <span class="text-[15px] text-[var(--color-ink)]">{item}</span>
                <span class="text-sm font-semibold text-[var(--color-coral)]">{price}</span>
              </div>
            ))}
          </div>
        </div>

        <aside class="lg:col-span-5" data-reveal>
          <div class="card card-elev p-7 lg:sticky lg:top-28">
            <div class="text-xs uppercase tracking-wider font-semibold text-[var(--color-coral)]">Bestellen</div>
            <h3 class="text-2xl font-display mt-1.5">Voor de volgende ochtend</h3>
            <p class="mt-3 text-sm text-[var(--color-ink-soft)]">
              In de demo tonen we hoe het bestelformulier eruit komt te zien. In de live versie kunnen gasten direct vanaf hun telefoon bestellen.
            </p>

            <div class="mt-5 space-y-3 text-sm">
              <div class="flex items-start gap-3">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mt-0.5 shrink-0"><path d="M3 8l3 3 7-7" stroke="var(--color-leaf)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="text-[var(--color-ink-soft)]">Bestelling tot 18:00 de avond ervoor</span>
              </div>
              <div class="flex items-start gap-3">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mt-0.5 shrink-0"><path d="M3 8l3 3 7-7" stroke="var(--color-leaf)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="text-[var(--color-ink-soft)]">Ophalen tussen 08:00 en 10:00</span>
              </div>
              <div class="flex items-start gap-3">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mt-0.5 shrink-0"><path d="M3 8l3 3 7-7" stroke="var(--color-leaf)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="text-[var(--color-ink-soft)]">Betaal contant of via Tikkie</span>
              </div>
            </div>

            <a href="/contact" class="btn btn-coral w-full mt-7">Vraag info aan</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>
