---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const highlights = [
  {
    title: 'Renesse',
    distance: '3 km',
    desc: 'Levendig kustdorp met restaurants, terrasjes en gezellige winkeltjes. Op de fiets ben je er in tien minuten.',
    icon: 'beach',
  },
  {
    title: 'Noordzeestrand',
    distance: '3 km',
    desc: 'Ruim, schoon en eindeloos. Ideaal voor strandwandelingen, zwemmen en de zonsondergang vanaf het duin.',
    icon: 'wave',
  },
  {
    title: 'Brouwersdam',
    distance: '10 km',
    desc: 'Surf-paradijs aan de ene kant, het rustige Grevelingenmeer aan de andere. Bootverhuur en vissteigers.',
    icon: 'wind',
  },
  {
    title: 'Oosterscheldekering & Neeltje Jans',
    distance: '15 km',
    desc: 'De Deltawerken van dichtbij, met museum en zicht over de Oosterschelde: Nationaal Park.',
    icon: 'bridge',
  },
  {
    title: 'Zierikzee',
    distance: '20 km',
    desc: 'Historische binnenstad met haventjes, smalle straatjes en gezellige terrassen.',
    icon: 'town',
  },
  {
    title: 'Watersnoodmuseum',
    distance: '25 km',
    desc: 'Indrukwekkend museum over de watersnoodramp van 1953: een stuk geschiedenis dat je niet mag missen.',
    icon: 'museum',
  },
];

const activities = [
  ['Fietsen', 'Honderden kilometers veilige fietspaden over het hele eiland en zelfs naar buureilanden via veerponten.'],
  ['Wandelen', 'Duingebieden, polders, stranden en bossen: voor elke conditie een geschikte route.'],
  ['Surfen & watersport', 'Brouwersdam is een hotspot voor windsurfers, kitesurfers en supliefhebbers.'],
  ['Paardrijden', 'Twee maneges in de buurt voor strand- en bostochten.'],
  ['Vissen & duiken', 'De Oosterschelde is een topbestemming voor sportduikers en hengelvissers.'],
  ['Vogelreservaat Prunje', 'Op fietsafstand: een wetland vol kustvogels en zeldzame soorten.'],
];

const omgevingBeelden = [
  { img: '/images/omg-strand.webp', caption: 'Het Noordzeestrand bij Renesse' },
  { img: '/images/omg-oosterschelde.webp', caption: 'Zonsondergang bij de Oosterscheldekering' },
  { img: '/images/omg-vuurtoren.webp', caption: 'Vuurtoren van Burgh-Haamstede' },
  { img: '/images/omg-natuur.webp', caption: 'Natuurgebied bij Stompetoren' },
  { img: '/images/omg-zeelandbrug.webp', caption: 'De Zeelandbrug over de Oosterschelde' },
  { img: '/images/omg-koeien.webp', caption: 'Polderleven rond plan Tureluur' },
];
---
<Layout title="De omgeving" description="Wat is er te doen rondom Recreatiebedrijf Boot? Strand, Renesse, Brouwersdam, Zierikzee: alles binnen handbereik.">
  <PageHero
    eyebrow="Schouwen-Duiveland"
    title="Een eiland vol ontdekken, vlak voor onze deur."
    description="Van het Noordzeestrand tot het Watersnoodmuseum, en van Renesse tot Zierikzee: onze plek is een uitvalsbasis waar je in tien minuten overal bent."
  />

  <section class="section">
    <div class="container-x">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal>
        {highlights.map(h => (
          <div class="card card-elev">
            <div class="flex items-center justify-between mb-4">
              <span class="chip chip-coral">{h.distance}</span>
            </div>
            <h3 class="text-2xl font-display">{h.title}</h3>
            <p class="mt-3 text-[15px] text-[var(--color-ink-soft)] leading-relaxed">{h.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-sand-soft)] border-y border-[var(--color-line)]">
    <div class="container-x">
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-5" data-reveal>
          <span class="dateline mb-5">Wat je hier kunt doen</span>
          <h2 class="heading-xl text-balance">
            Buiten zijn met
            <span class="italic-display text-[var(--color-coral)]">de tijd om je heen</span>.
          </h2>
          <p class="mt-5 text-[var(--color-ink-soft)] text-base sm:text-lg max-w-md">
            We delen graag onze tips. Bij de receptie liggen routekaarten klaar en weten we precies waar de minder bekende plekjes zijn.
          </p>

          <div class="mt-10 hidden lg:block">
            <figure class="max-w-[340px]">
              <div class="rounded-[1.25rem] overflow-hidden aspect-[4/3] bg-[var(--color-mist)] shadow-[0_32px_60px_-26px_rgba(20,57,69,0.4)]">
                <img src="/images/zonsondergang.webp" alt="Zonsondergang bij de Oosterscheldekering, in de buurt van Recreatiebedrijf Boot" loading="lazy" class="w-full h-full object-cover"/>
              </div>
              <figcaption class="mt-3 text-sm text-[var(--color-ink-mute)]">Oosterscheldekering bij zonsondergang</figcaption>
            </figure>
          </div>
        </div>
        <div class="lg:col-span-7" data-reveal>
          <ul class="divide-y divide-[var(--color-line)]">
            {activities.map(([t, d]) => (
              <li class="py-5 grid sm:grid-cols-4 gap-4">
                <div class="sm:col-span-1">
                  <div class="text-base font-semibold text-[var(--color-sea-deep)] font-display">{t}</div>
                </div>
                <div class="sm:col-span-3 text-[15px] text-[var(--color-ink-soft)]">{d}</div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="max-w-2xl mb-10 sm:mb-12" data-reveal>
        <span class="dateline mb-5">Beelden uit de omgeving</span>
        <h2 class="heading-xl text-balance">
          De mooiste plekken van
          <span class="italic-display text-[var(--color-coral)]">Schouwen-Duiveland</span>.
        </h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5" data-reveal>
        {omgevingBeelden.map(b => (
          <figure class="relative rounded-2xl overflow-hidden group aspect-[4/3] img-zoom bg-[var(--color-mist)]">
            <img src={b.img} alt={b.caption} loading="lazy" class="w-full h-full object-cover"/>
            <figcaption class="absolute inset-x-0 bottom-0 p-4 pt-10 text-white text-sm font-medium bg-gradient-to-t from-black/65 to-transparent">
              {b.caption}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <figure class="rounded-[2rem] px-6 py-14 sm:px-10 sm:py-16 lg:py-20 bg-mesh-sea text-white relative overflow-hidden text-center" data-reveal>
        <div class="max-w-3xl mx-auto">
          <svg class="mx-auto mb-6 text-[var(--color-amber)]" width="46" height="38" viewBox="0 0 56 46" fill="currentColor" aria-hidden="true" style="opacity:.55">
            <path d="M0 46V28C0 12 8 2 22 0v8c-7 2-11 8-11 16h11v22H0zm32 0V28c0-16 8-26 22-28v8c-7 2-11 8-11 16h11v22H32z"/>
          </svg>

          <div class="text-[11px] uppercase tracking-[0.22em] font-semibold text-[var(--color-amber)] mb-6">Tip van de familie</div>

          <blockquote class="quote-xl text-balance text-white">
            Op een rustige avond fiets je via de duinen naar de Brouwersdam voor de zonsondergang. Onze favoriete plek.
          </blockquote>

          <figcaption class="mt-8 flex items-center justify-center gap-3 text-sm">
            <span class="w-8 h-px bg-white/25"></span>
            <span class="font-semibold text-white">Gertjan &amp; Lisette</span>
            <span class="w-8 h-px bg-white/25"></span>
          </figcaption>

          <div class="mt-9">
            <a href="/arrangementen" class="btn btn-glass btn-lg">Bekijk arrangementen</a>
          </div>
        </div>
      </figure>
    </div>
  </section>
</Layout>
