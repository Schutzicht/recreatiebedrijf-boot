---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { arrangementen } from '../data/site';
---
<Layout title="Arrangementen" description="Speciale verblijven rond Kunstschouw en Stroâ: twee Zeeuwse tradities, één vakantie.">
  <PageHero
    eyebrow="Voor de echte Zeeland-liefhebber"
    title="Arrangementen die je verblijf bijzonder maken."
    description="Twee tradities die je hier in Schouwen-Duiveland alleen vindt. Wij regelen het verblijf, jij hoeft alleen maar te genieten."
  />

  <section class="section">
    <div class="container-x">
      <div class="space-y-10" data-reveal>
        {arrangementen.map((a, idx) => (
          <article id={a.slug} class="card card-elev p-0 overflow-hidden">
            <div class={`grid lg:grid-cols-2 gap-0 ${idx % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
              <div class="aspect-[5/4] lg:aspect-auto bg-[var(--color-mist)] img-zoom">
                <img src={a.image} alt={a.name} class="w-full h-full object-cover"/>
              </div>
              <div class="p-8 lg:p-12">
                <div class="text-xs uppercase tracking-wider font-semibold text-[var(--color-coral)]">{a.period}</div>
                <h2 class="text-3xl lg:text-4xl font-display mt-3">{a.name}</h2>
                <p class="mt-4 text-[15px] text-[var(--color-ink-soft)] leading-relaxed">{a.description}</p>

                <h3 class="text-sm font-semibold text-[var(--color-sea-deep)] mt-7 mb-3 uppercase tracking-wider">Inclusief</h3>
                <ul class="space-y-2.5">
                  {a.inclusief.map((i: string) => (
                    <li class="flex items-start gap-3 text-[15px] text-[var(--color-ink-soft)]">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mt-1 shrink-0">
                        <path d="M3 8l3 3 7-7" stroke="var(--color-coral)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      {i}
                    </li>
                  ))}
                </ul>

                <div class="mt-8 flex flex-wrap gap-3">
                  <a href="/reserveren" class="btn btn-coral">Boek dit arrangement</a>
                  <a href="/contact" class="btn btn-outline">Vraag info aan</a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
