---
import Layout from '../layouts/Layout.astro';
import AccommodationCard from '../components/AccommodationCard.astro';
import Stars from '../components/Stars.astro';
import WaveDivider from '../components/WaveDivider.astro';
import { accommodations, testimonials, reviewLogos, site, arrangementen } from '../data/site';

const featured = accommodations[0];
const otherAccommodations = accommodations.slice(1);
const heroQuote = testimonials[0];
const sideQuotes = testimonials.slice(1);

const heroImage = '/images/camping-noordzee.jpg';
const aerial = '/images/luchtfoto-2.jpg';
const sunset = '/images/sfeer.jpg';
---
<Layout title="Familiecamping op Schouwen-Duiveland" description="Recreatiebedrijf Boot in Noordwelle: gastvrije familiecamping vlakbij Renesse. Mini-camping, appartementen, safaritent, vakantiehuisjes en caravanstalling.">

  <section class="relative min-h-[86vh] sm:min-h-[88vh] lg:min-h-[92vh] flex items-end overflow-hidden">
    <div class="hero-media">
      <img src={heroImage} alt="De camping van Recreatiebedrijf Boot in Noordwelle, met zicht op de Noordzee" />
    </div>

    <div class="container-x relative z-10 pb-12 sm:pb-16 lg:pb-24 pt-32 sm:pt-36 lg:pt-40 text-white">
      <div class="max-w-4xl" data-reveal>
        <div class="dateline dateline-light mb-7 sm:mb-9 text-white/80">
          <span>Sinds 1968</span>
          <span aria-hidden="true">·</span>
          <span>Noordwelle</span>
          <span aria-hidden="true">·</span>
          <span>Schouwen-Duiveland</span>
        </div>

        <h1 class="text-white text-balance leading-[1.0] tracking-tight font-display"
            style="font-size: clamp(2.5rem, 7vw, 6rem); font-weight: 500;">
          Onbezorgd recreëren
          <span class="block italic-display text-[var(--color-amber)]" style="font-weight: 400;">aan de Zeeuwse kust.</span>
        </h1>

        <p class="mt-7 sm:mt-9 text-base sm:text-lg lg:text-xl text-white/85 max-w-xl text-pretty leading-relaxed">
          Een gastvrij familiebedrijf met camping, appartementen, safaritent en vakantiehuisjes. Op fietsafstand van Renesse, het Noordzeestrand en de Brouwersdam.
        </p>

        <div class="mt-8 sm:mt-10 flex flex-wrap gap-3">
          <a href="/reserveren" class="btn btn-coral btn-lg">Vind jouw plekje</a>
          <a href="/accommodaties" class="btn btn-on-dark btn-lg">Verblijven verkennen</a>
        </div>
      </div>

      <div class="mt-12 sm:mt-16 lg:mt-20 grid sm:grid-cols-2 gap-y-6 gap-x-10 items-end" data-reveal>
        <div class="flex flex-wrap items-center gap-x-7 gap-y-3 text-white/75 text-sm">
          <div class="flex items-center gap-2">
            <Stars />
            <span class="font-semibold text-white">8,9</span>
            <span>Zoover</span>
          </div>
          <div class="flex items-center gap-2">
            <Stars />
            <span class="font-semibold text-white">4,7</span>
            <span>Google</span>
          </div>
          <span class="hidden md:inline-block w-px h-4 bg-white/20"></span>
          <span class="hidden md:inline">ANWB · ACSI aanbevolen</span>
        </div>

        <div class="sm:text-right">
          <div class="text-xs uppercase tracking-[0.18em] font-semibold text-white/60 mb-1">Welkom thuis aan zee</div>
          <div class="font-script text-[2rem] sm:text-[2.5rem] leading-none text-[var(--color-amber)]" style="font-weight: 600;">
            Gertjan &amp; Lisette
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee strip with Zeeland places -->
  <section class="py-7 sm:py-9 bg-[var(--color-sea-deep)] text-[var(--color-amber)] border-y border-[var(--color-sea)]/30 overflow-hidden">
    <div class="marquee-strip" aria-hidden="true">
      <div class="marquee-track">
        {[
          'Noordwelle','Renesse','Brouwersdam','Schouwen','Zierikzee','Kop van Schouwen','Neeltje Jans','Oosterschelde','Watersnoodmuseum','Grevelingenmeer','Westhoek','Lokkershofweg',
          'Noordwelle','Renesse','Brouwersdam','Schouwen','Zierikzee','Kop van Schouwen','Neeltje Jans','Oosterschelde','Watersnoodmuseum','Grevelingenmeer','Westhoek','Lokkershofweg'
        ].map(place => (
          <span class="italic-display whitespace-nowrap text-2xl sm:text-3xl lg:text-4xl tracking-tight" style="font-weight: 400;">{place} <span class="text-white/35 mx-3">✻</span></span>
        ))}
      </div>
    </div>
    <span class="sr-only">Zeeuwse plaatsen op fietsafstand</span>
  </section>

  <!-- Brief van de familie -->
  <section class="section bg-[var(--color-paper)] relative overflow-hidden">
    <div class="container-x">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-5 order-2 lg:order-1" data-reveal>
          <div class="polaroid rotate-left max-w-[420px] mx-auto lg:mx-0">
            <div class="polaroid-img aspect-[4/5]">
              <img src={aerial} alt="Het terrein van Recreatiebedrijf Boot vanuit de lucht" loading="lazy"/>
            </div>
            <div class="polaroid-caption">Onze plek, vanaf onze drone</div>
          </div>
        </div>

        <div class="lg:col-span-7 order-1 lg:order-2" data-reveal>
          <span class="dateline mb-6">
            <span>Brief van de familie</span>
          </span>

          <h2 class="text-balance leading-[1.06] tracking-tight font-display"
              style="font-size: clamp(2rem, 4.4vw, 3.5rem); font-weight: 500;">
            Een plek waar gezinnen zich meteen
            <span class="italic-display text-[var(--color-coral)]" style="font-weight: 500;">thuis</span> voelen.
          </h2>

          <div class="mt-7 space-y-5 text-[15px] sm:text-[17px] text-[var(--color-ink-soft)] leading-relaxed text-pretty max-w-xl">
            <p>
              Twee jaar geleden namen wij dit familiebedrijf over van de vorige eigenaars. Wat ons drijft? Mensen welkom heten op een plek waar de tijd écht weer voelt als vakantie.
            </p>
            <p>
              Geen festivalcamping, geen luxeresort. Gewoon ruimte, rust en buitenleven, met de zee binnen handbereik. We koken zelf de broodjesservice, kennen iedere visgrond en weten waar de mooiste zonsondergang valt.
            </p>
            <p>
              Tot ziens op het terrein.
            </p>
          </div>

          <div class="mt-7 flex items-end gap-5">
            <div>
              <div class="font-script text-4xl sm:text-5xl text-[var(--color-sea-deep)] leading-none" style="font-weight: 700;">
                Gertjan &amp; Lisette
              </div>
              <div class="text-xs uppercase tracking-[0.18em] font-semibold text-[var(--color-ink-mute)] mt-2">Gastvrouw &amp; gastheer</div>
            </div>
          </div>

          <div class="mt-10 grid grid-cols-3 gap-5 sm:gap-7 max-w-md">
            <div>
              <div class="font-display font-medium text-[var(--color-sea-deep)]" style="font-size: clamp(1.5rem, 3vw, 2rem);">3 km</div>
              <div class="text-xs sm:text-sm text-[var(--color-ink-mute)] mt-1 leading-snug">Noordzeestrand</div>
            </div>
            <div>
              <div class="font-display font-medium text-[var(--color-sea-deep)]" style="font-size: clamp(1.5rem, 3vw, 2rem);">370 m²</div>
              <div class="text-xs sm:text-sm text-[var(--color-ink-mute)] mt-1 leading-snug">Ruimste plek</div>
            </div>
            <div>
              <div class="font-display font-medium text-[var(--color-sea-deep)]" style="font-size: clamp(1.5rem, 3vw, 2rem);">7</div>
              <div class="text-xs sm:text-sm text-[var(--color-ink-mute)] mt-1 leading-snug">Appartementen</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <WaveDivider color="var(--color-coral)" bg="var(--color-paper)" />

  <section class="section bg-[var(--color-sand-soft)] border-y border-[var(--color-line)]">
    <div class="container-x">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10 sm:mb-12" data-reveal>
        <div class="max-w-2xl">
          <span class="dateline mb-5">Onze verblijven</span>
          <h2 class="text-balance leading-[1.05] tracking-tight font-display"
              style="font-size: clamp(2rem, 4.4vw, 3.25rem); font-weight: 500;">
            Voor ieder gezin <span class="italic-display text-[var(--color-coral)]" style="font-weight: 500;">de juiste plek</span>.
          </h2>
          <p class="mt-4 text-[var(--color-ink-soft)] text-base sm:text-lg max-w-xl">
            Of je nu komt kamperen, een appartement boekt of het luxe gevoel van een safaritent zoekt: er is altijd een plek die bij je past.
          </p>
        </div>
        <a href="/accommodaties" class="btn btn-outline">Alle accommodaties</a>
      </div>

      <!-- Featured: mini-camping -->
      <div class="mb-5" data-reveal>
        <AccommodationCard {...featured} featured={true} />
      </div>

      <!-- Other accommodations in editorial 3-col grid -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5" data-reveal>
        {otherAccommodations.map(a => (
          <AccommodationCard {...a} />
        ))}
      </div>
    </div>
  </section>

  <section class="section relative overflow-hidden bg-mesh-sea">
    <div class="container-x">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 text-white" data-reveal>
          <span class="eyebrow eyebrow-light mb-5">Onze plek op het eiland</span>
          <h2 class="text-white text-4xl lg:text-5xl text-balance leading-[1.05]">
            Centraal op de kop van Schouwen-Duiveland.
          </h2>
          <p class="mt-5 text-white/85 text-lg max-w-xl text-pretty">
            Vanaf onze camping fiets je in vijf minuten richting de duinen, in tien naar het strand en in een kwartier naar het centrum van Renesse. De Brouwersdam, Grevelingenmeer en de Oosterscheldekering zijn allemaal binnen handbereik.
          </p>
          <ul class="mt-8 space-y-3.5">
            {[
              ['3 km', 'Noordzeestrand & Renesse'],
              ['10 min', 'Brouwersdam: surfen, vissen, zonsondergangen'],
              ['15 min', 'Oosterscheldekering en Neeltje Jans'],
              ['20 min', 'Zierikzee: historische binnenstad'],
            ].map(([d, label]) => (
              <li class="flex items-start gap-4">
                <span class="inline-flex shrink-0 items-center justify-center w-16 px-2 py-1 rounded-full bg-white/10 border border-white/15 text-xs font-semibold text-[var(--color-amber)]">{d}</span>
                <span class="text-white/90">{label}</span>
              </li>
            ))}
          </ul>
          <div class="mt-9">
            <a href="/omgeving" class="btn btn-on-dark">Ontdek de omgeving</a>
          </div>
        </div>

        <div class="lg:col-span-5" data-reveal>
          <div class="photo-stack">
            <div class="frame aspect-[4/5]">
              <img src={sunset} alt="Zonsondergang aan de Zeeuwse kust, vlakbij Recreatiebedrijf Boot" />
            </div>
            <div class="absolute -bottom-5 -left-5 lg:-bottom-8 lg:-left-8 frame aspect-[4/3] w-[55%] hidden sm:block">
              <img src={aerial} alt="Luchtfoto van het kampeerterrein van Boot in Noordwelle" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-paper)] relative overflow-hidden">
    <div class="container-x">
      <div class="max-w-3xl mb-10 sm:mb-14" data-reveal>
        <span class="dateline mb-5">Wat gasten zeggen</span>
        <h2 class="text-balance leading-[1.05] tracking-tight font-display"
            style="font-size: clamp(2rem, 4.4vw, 3.25rem); font-weight: 500;">
          Drie generaties komen hier inmiddels
          <span class="italic-display text-[var(--color-coral)]" style="font-weight: 500;">op vakantie</span>.
        </h2>
      </div>

      <!-- Editorial pull-quote: één grote uitgelichte quote -->
      <figure class="relative max-w-4xl mx-auto py-6 sm:py-10" data-reveal>
        <svg class="absolute -top-2 left-0 lg:-left-6 text-[var(--color-coral)]/30" width="56" height="46" viewBox="0 0 56 46" aria-hidden="true">
          <path d="M0 46V28C0 12 8 2 22 0v8c-7 2-11 8-11 16h11v22H0zm32 0V28c0-16 8-26 22-28v8c-7 2-11 8-11 16h11v22H32z" fill="currentColor"/>
        </svg>
        <blockquote class="italic-display text-[var(--color-ink)] text-pretty"
                    style="font-size: clamp(1.5rem, 3.4vw, 2.5rem); font-weight: 400; line-height: 1.18; letter-spacing: -0.01em;">
          {heroQuote.text}
        </blockquote>
        <figcaption class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2">
          <Stars count={heroQuote.rating} />
          <span class="text-sm font-semibold text-[var(--color-sea-deep)]">{heroQuote.name}</span>
          <span class="w-1 h-1 rounded-full bg-[var(--color-line-soft)]"></span>
          <span class="text-sm text-[var(--color-ink-mute)]">{heroQuote.location} · {heroQuote.stay}</span>
        </figcaption>
      </figure>

      <!-- Side quotes + review scores in mixed editorial grid -->
      <div class="mt-12 sm:mt-16 grid lg:grid-cols-12 gap-6 lg:gap-8" data-reveal>
        <div class="lg:col-span-7 grid sm:grid-cols-2 gap-5">
          {sideQuotes.map(t => (
            <div class="card card-elev">
              <Stars count={t.rating} />
              <p class="mt-4 text-[15px] text-[var(--color-ink)] leading-relaxed">{t.text}</p>
              <div class="mt-5 pt-5 border-t border-[var(--color-line-soft)]">
                <div class="text-sm font-semibold text-[var(--color-sea-deep)]">{t.name}</div>
                <div class="text-xs text-[var(--color-ink-mute)] mt-0.5">{t.location} · {t.stay}</div>
              </div>
            </div>
          ))}
        </div>

        <div class="lg:col-span-5 flex flex-col gap-3">
          <div class="text-xs uppercase tracking-[0.18em] font-semibold text-[var(--color-ink-mute)] mb-1">Onze scores</div>
          <div class="grid grid-cols-2 gap-3">
            {reviewLogos.map(r => (
              <div class="card card-elev px-4 py-5 flex flex-col items-start justify-center min-h-[104px]">
                <div class="text-[11px] uppercase tracking-[0.14em] font-semibold text-[var(--color-ink-mute)]">{r.name}</div>
                <div class={`mt-1 font-display font-medium text-[var(--color-sea-deep)] leading-tight ${r.score.length > 4 ? 'text-lg' : 'text-3xl'}`}>{r.score}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <WaveDivider color="var(--color-coral)" bg="var(--color-paper)" flip={true} />

  <section class="section bg-[var(--color-sand-soft)] border-y border-[var(--color-line)]">
    <div class="container-x">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10 sm:mb-12" data-reveal>
        <div class="max-w-2xl">
          <span class="dateline mb-5">Arrangementen</span>
          <h2 class="text-balance leading-[1.05] tracking-tight font-display"
              style="font-size: clamp(2rem, 4.4vw, 3.25rem); font-weight: 500;">
            Maak van je verblijf
            <span class="italic-display text-[var(--color-coral)]" style="font-weight: 500;">een belevenis</span>.
          </h2>
        </div>
        <a href="/arrangementen" class="btn btn-outline">Alle arrangementen</a>
      </div>
      <div class="grid lg:grid-cols-2 gap-5" data-reveal>
        {arrangementen.map(a => (
          <a href={`/arrangementen#${a.slug}`} class="card card-hover p-0 overflow-hidden group">
            <div class="grid sm:grid-cols-5">
              <div class="sm:col-span-2 aspect-[4/3] sm:aspect-auto img-zoom bg-[var(--color-mist)]">
                <img src={a.image} alt={a.name} loading="lazy" />
              </div>
              <div class="sm:col-span-3 p-6">
                <div class="text-xs uppercase tracking-wider font-semibold text-[var(--color-coral)]">{a.period}</div>
                <h3 class="text-2xl font-display mt-2">{a.name}</h3>
                <p class="mt-3 text-[15px] text-[var(--color-ink-soft)] truncate-3">{a.short}</p>
                <div class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-sea)] group-hover:text-[var(--color-coral)] transition-colors">
                  Lees meer
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-paper)]">
    <div class="container-x">
      <div class="grid lg:grid-cols-2 gap-5">
        <a href="/fietsverhuur" class="card card-hover group p-8 lg:p-10" data-reveal>
          <div class="flex items-start gap-5">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-mist)] flex items-center justify-center shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <circle cx="6" cy="17" r="4" stroke="var(--color-sea)" stroke-width="1.6"/>
                <circle cx="18" cy="17" r="4" stroke="var(--color-sea)" stroke-width="1.6"/>
                <path d="M6 17l4-7h6m-3-2l3 2 2 5" stroke="var(--color-sea)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-display">Fietsverhuur via Died's Fiets</h3>
              <p class="mt-3 text-[15px] text-[var(--color-ink-soft)] leading-relaxed">
                Eigen fiets vergeten? Geen probleem. Wij regelen je huurfiets samen met Died's Fiets, inclusief bezorging op de camping. Stadsfietsen, e-bikes en kinderfietsen beschikbaar.
              </p>
              <div class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-sea)] group-hover:text-[var(--color-coral)] transition-colors">
                Naar fietsverhuur
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </div>
          </div>
        </a>

        <a href="/broodjesservice" class="card card-hover group p-8 lg:p-10" data-reveal>
          <div class="flex items-start gap-5">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-mist)] flex items-center justify-center shrink-0">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <path d="M4 11c0-3 4-5 8-5s8 2 8 5v1H4z" stroke="var(--color-sea)" stroke-width="1.6" stroke-linejoin="round"/>
                <path d="M4 14h16M5 16l-1 4h16l-1-4" stroke="var(--color-sea)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <h3 class="text-2xl font-display">Verse broodjesservice</h3>
              <p class="mt-3 text-[15px] text-[var(--color-ink-soft)] leading-relaxed">
                Bestel de avond van tevoren en haal 's ochtends warm brood en versgebakken croissants op bij de receptie. Net even het verschil tijdens de vakantie.
              </p>
              <div class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-sea)] group-hover:text-[var(--color-coral)] transition-colors">
                Naar broodjesservice
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section
    class="section relative overflow-hidden"
    style={`background-image: linear-gradient(rgba(20,57,69,0.78), rgba(20,57,69,0.88)), url(${sunset}); background-size: cover; background-position: center;`}
  >
    <div class="container-x text-center relative z-10" data-reveal>
      <div class="font-script leading-none mb-4 sm:mb-6 text-[var(--color-amber)]"
           style="font-size: clamp(1.75rem, 3.2vw, 2.25rem); font-weight: 600;">
        We zien jullie graag aan zee
      </div>

      <h2 class="text-white text-balance max-w-3xl mx-auto leading-[1.04] tracking-tight font-display"
          style="color: white; font-size: clamp(2.25rem, 5.4vw, 4.5rem); font-weight: 500;">
        Plan jullie zomer
        <span class="italic-display text-[var(--color-amber)]" style="font-weight: 400;">aan de Zeeuwse kust</span>.
      </h2>

      <p class="mt-6 max-w-xl mx-auto text-base sm:text-lg leading-relaxed text-pretty" style="color: rgba(255,255,255,0.88);">
        Stuur ons jullie wensen of bel ons rechtstreeks. We reageren binnen 24 uur, ook in het weekend.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/reserveren" class="btn btn-coral btn-lg">Vind jullie plek</a>
        <a href={site.phoneHref} class="btn btn-on-dark btn-lg">
          <svg width="14" height="14" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M3 4l3-1 1.5 3-1.5 1.5c.8 1.5 2 2.7 3.5 3.5L11 9.5l3 1.5-1 3c-5 0-10-5-10-10z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          </svg>
          {site.phone}
        </a>
      </div>

      <div class="mt-10 inline-flex items-center gap-3 text-white/65 text-sm">
        <span class="w-8 h-px bg-white/30"></span>
        <span class="font-script text-xl text-[var(--color-amber)]" style="font-weight: 600;">Gertjan &amp; Lisette</span>
        <span class="w-8 h-px bg-white/30"></span>
      </div>
    </div>
  </section>

</Layout>
