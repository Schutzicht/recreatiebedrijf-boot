---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const facilities = [
  { letter: 'A', name: 'Receptie', desc: 'Inchecken, broodjesbestelling en lokale tips' },
  { letter: 'B', name: 'Speeltuin', desc: 'Trampoline, klimnet en speeltoestellen voor de kinderen' },
  { letter: 'C', name: 'Sanitairgebouw', desc: 'Twee verwarmde gebouwen met douches, toiletten en afwasplek' },
  { letter: 'D', name: 'Afvalcontainers', desc: 'Gescheiden afvalinzameling op meerdere plekken' },
  { letter: 'E', name: 'Wasserette', desc: 'Wasmachine en droger tegen kleine vergoeding' },
  { letter: 'F', name: 'Hooiberg', desc: 'Sfeervolle hooiberg op Veld 1' },
  { letter: 'G', name: 'Dierenweide', desc: 'Kippen, geit en konijnen voor de kleinsten' },
  { letter: 'H', name: 'Fietsenstalling', desc: 'Veilige overdekte stalling voor fietsen' },
  { letter: 'I', name: 'Caravanstalling / schuur', desc: 'Overdekte stalling voor caravans en boten tot 8 meter' },
  { letter: 'J', name: 'Privésanitair', desc: 'Te huren privésanitair op Veld 1' },
  { letter: 'K', name: 'Stortplaats vuilwater campers', desc: 'Voor het lozen van afvalwater van campers en caravans' },
  { letter: 'L', name: 'Laadpaal auto', desc: 'Twee laadpunten voor elektrische auto\'s' },
  { letter: 'M', name: 'Paardenwei', desc: 'Aan de oostgrens van het terrein' },
];

// Hotspots — coordinaten in % (left, top) op de plattegrond-afbeelding.
// Sommige letters komen meerdere keren voor (sanitair, afval, laadpaal).
const hotspots = [
  { letter: 'F', x: 33.5, y: 16.5 },
  { letter: 'B', x: 53.5, y: 31 },
  { letter: 'I', x: 37, y: 34 },
  { letter: 'C', x: 28.5, y: 32.5 },
  { letter: 'D', x: 29, y: 35 },
  { letter: 'J', x: 30, y: 39 },
  { letter: 'L', x: 36.5, y: 39 },
  { letter: 'H', x: 43, y: 39 },
  { letter: 'E', x: 33, y: 54 },
  { letter: 'D', x: 42.5, y: 63 },
  { letter: 'G', x: 57, y: 54 },
  { letter: 'A', x: 51.5, y: 69 },
  { letter: 'D', x: 68, y: 46 },
  { letter: 'C', x: 71.5, y: 49 },
  { letter: 'K', x: 78, y: 58 },
  { letter: 'L', x: 80, y: 78 },
  { letter: 'M', x: 92, y: 43 },
];
---
<Layout title="Plattegrond" description="Interactieve plattegrond van Recreatiebedrijf Boot in Noordwelle. Bekijk waar de kampeerplaatsen, appartementen, safaritent en alle voorzieningen liggen.">
  <PageHero
    eyebrow="Onze camping in beeld"
    title="Plattegrond"
    description="Hover over of klik op een faciliteit in de lijst om hem op de kaart te vinden. Zo zie je in één oogopslag waar receptie, sanitair, speeltuin en stalling liggen."
  />

  <section class="section">
    <div class="container-x">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-10">

        <aside class="lg:col-span-4 order-2 lg:order-1">
          <div class="lg:sticky lg:top-24">
            <div class="flex items-center justify-between mb-5">
              <h2 class="text-2xl font-display">Faciliteiten</h2>
              <span class="text-xs text-[var(--color-ink-mute)]">A t/m M</span>
            </div>
            <ul class="legend-list" data-legend>
              {facilities.map(f => (
                <li>
                  <button class="legend-item w-full" data-letter={f.letter} type="button" aria-label={`Markeer ${f.name} op de plattegrond`}>
                    <span class="legend-letter">{f.letter}</span>
                    <span class="text-left">
                      <span class="legend-name">{f.name}</span>
                      <span class="legend-desc">{f.desc}</span>
                    </span>
                  </button>
                </li>
              ))}
            </ul>

            <div class="mt-6 p-4 rounded-2xl bg-[var(--color-mist)] border border-[var(--color-mist-deep)] text-sm">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="inline-block w-3 h-3 rounded-full bg-[#7BB6B0]"></span>
                <span class="font-semibold text-[var(--color-sea-deep)]">Appartement</span>
                <span class="ml-3 inline-block w-3 h-3 rounded-full bg-[#3D2A6B]"></span>
                <span class="font-semibold text-[var(--color-sea-deep)]">Safaritent</span>
                <span class="ml-3 inline-block w-3 h-3 rounded-full bg-[#B266B2]"></span>
                <span class="font-semibold text-[var(--color-sea-deep)]">Kampeerplaats</span>
              </div>
              <div class="text-xs text-[var(--color-ink-mute)] mt-2">Plekvoorkeur op een specifieke plaats? Bel of mail ons even, dan denken we mee.</div>
            </div>
          </div>
        </aside>

        <div class="lg:col-span-8 order-1 lg:order-2">
          <div class="map-wrap relative rounded-3xl overflow-hidden border border-[var(--color-line)] bg-[var(--color-sand-soft)] shadow-[0_24px_60px_-24px_rgba(20,57,69,0.18)]" data-map>
            <img
              src="/images/plattegrond.jpg"
              alt="Plattegrond Recreatiebedrijf Boot Noordwelle"
              class="w-full h-auto block"
              loading="lazy"
            />
            <div class="absolute inset-0" data-hotspots>
              {hotspots.map((h, i) => (
                <span
                  class="map-hotspot"
                  data-letter={h.letter}
                  data-index={i}
                  style={`left:${h.x}%; top:${h.y}%`}
                  aria-hidden="true"
                ></span>
              ))}
            </div>
            <div class="absolute inset-0 pointer-events-none hidden" data-calibrate-overlay></div>
          </div>

          <div class="mt-4 flex items-start justify-between gap-4">
            <div class="flex items-start gap-3 text-sm text-[var(--color-ink-mute)]">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mt-0.5 shrink-0">
                <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4"/>
                <path d="M8 5v3M8 10.5v.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
              <span>Tik of klik op een letter in de lijst hiernaast om de bijbehorende faciliteit op de kaart te markeren.</span>
            </div>
            <button type="button" data-calibrate-toggle class="text-[11px] uppercase tracking-wider font-semibold text-[var(--color-ink-mute)] hover:text-[var(--color-coral)] transition-colors">
              Dev: kalibreer
            </button>
          </div>

          <div class="hidden mt-3 p-4 rounded-2xl bg-[var(--color-sea-deep)] text-white text-xs font-mono" data-calibrate-panel>
            <div class="flex items-center justify-between mb-2">
              <span class="font-sans font-semibold text-[13px]">Kalibratie-modus actief</span>
              <button type="button" data-calibrate-copy class="text-[11px] uppercase tracking-wider font-semibold text-[var(--color-amber)] font-sans">Kopieer array</button>
            </div>
            <div class="font-sans text-[12px] text-white/70 mb-3">Klik op een letter in de lijst hiernaast om hem te selecteren, klik dan op de kaart om de coördinaat van die hotspot te zetten. Hieronder zie je de hotspots-array die je in <code class="bg-white/10 px-1 rounded">plattegrond.astro</code> kunt plakken.</div>
            <pre class="whitespace-pre-wrap break-all max-h-[260px] overflow-auto bg-black/30 rounded p-3" data-calibrate-output></pre>
          </div>
        </div>

      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const items = document.querySelectorAll('.legend-item');
      const hotspots = document.querySelectorAll('.map-hotspot');
      const map = document.querySelector('[data-map]');
      const calibrateToggle = document.querySelector('[data-calibrate-toggle]');
      const calibratePanel = document.querySelector('[data-calibrate-panel]');
      const calibrateOutput = document.querySelector('[data-calibrate-output]');
      const calibrateCopy = document.querySelector('[data-calibrate-copy]');
      let pinned = null;

      function set(letter) {
        items.forEach(i => i.classList.toggle('is-active', i.getAttribute('data-letter') === letter));
        hotspots.forEach(h => h.classList.toggle('is-active', h.getAttribute('data-letter') === letter));
      }
      function clear() {
        items.forEach(i => i.classList.remove('is-active'));
        hotspots.forEach(h => h.classList.remove('is-active'));
      }

      items.forEach(item => {
        const letter = item.getAttribute('data-letter');
        item.addEventListener('mouseenter', () => { if (!pinned) set(letter); });
        item.addEventListener('focus', () => { if (!pinned) set(letter); });
        item.addEventListener('mouseleave', () => { if (!pinned) clear(); });
        item.addEventListener('blur', () => { if (!pinned) clear(); });
        item.addEventListener('click', (e) => {
          e.preventDefault();
          if (calibrating && pinned === letter) {
            // In calibration mode, second click = next hotspot of same letter
            return;
          }
          if (pinned === letter) {
            pinned = null;
            clear();
          } else {
            pinned = letter;
            set(letter);
          }
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          pinned = null;
          clear();
        }
      });

      // === Calibration mode ===
      let calibrating = false;
      let pickIndex = 0;

      function renderHotspotsArray() {
        const lines = Array.from(hotspots).map(h => {
          const letter = h.getAttribute('data-letter');
          const x = parseFloat(h.style.left).toFixed(2);
          const y = parseFloat(h.style.top).toFixed(2);
          return `  { letter: '${letter}', x: ${x}, y: ${y} },`;
        }).join('\n');
        if (calibrateOutput) calibrateOutput.textContent = `const hotspots = [\n${lines}\n];`;
      }

      if (calibrateToggle && calibratePanel && map) {
        calibrateToggle.addEventListener('click', () => {
          calibrating = !calibrating;
          calibratePanel.classList.toggle('hidden', !calibrating);
          map.classList.toggle('is-calibrating', calibrating);
          calibrateToggle.textContent = calibrating ? 'Dev: stop kalibreren' : 'Dev: kalibreer';
          if (calibrating) {
            renderHotspotsArray();
            console.info('[Plattegrond] Kalibratiemodus actief. Klik in legenda op een letter om te selecteren, klik dan op de kaart om de positie te zetten. Bij meerdere hotspots met dezelfde letter cycle je automatisch.');
          } else {
            pickIndex = 0;
          }
        });

        map.addEventListener('click', (e) => {
          if (!calibrating || !pinned) return;
          // Bereken klikpositie als percentage van map dimensions
          const rect = map.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width) * 100;
          const y = ((e.clientY - rect.top) / rect.height) * 100;
          // Zoek alle hotspots met deze letter, cycle door als er meer zijn
          const matching = Array.from(hotspots).filter(h => h.getAttribute('data-letter') === pinned);
          if (matching.length === 0) return;
          const target = matching[pickIndex % matching.length];
          target.style.left = x.toFixed(2) + '%';
          target.style.top = y.toFixed(2) + '%';
          pickIndex++;
          if (pickIndex >= matching.length) pickIndex = 0;
          renderHotspotsArray();
        });
      }

      if (calibrateCopy) {
        calibrateCopy.addEventListener('click', async () => {
          if (!calibrateOutput) return;
          try {
            await navigator.clipboard.writeText(calibrateOutput.textContent || '');
            calibrateCopy.textContent = 'Gekopieerd!';
            setTimeout(() => { calibrateCopy.textContent = 'Kopieer array'; }, 1600);
          } catch (err) {
            console.error('Kopiëren mislukt', err);
          }
        });
      }
    })();
  </script>

  <style>
    .map-wrap { isolation: isolate; }
    .map-wrap.is-calibrating { cursor: crosshair; }

    .map-hotspot {
      position: absolute;
      width: 26px; height: 26px;
      border-radius: 999px;
      transform: translate(-50%, -50%);
      pointer-events: none;
      background: transparent;
      border: 2px solid transparent;
      transition: background-color 240ms ease, border-color 240ms ease, box-shadow 240ms ease;
      z-index: 5;
    }
    .map-wrap.is-calibrating .map-hotspot {
      background: rgba(46, 115, 144, 0.20);
      border-color: var(--color-sea-soft);
    }
    .map-wrap.is-calibrating .map-hotspot::before {
      content: attr(data-letter);
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 11px;
      color: var(--color-sea-deep);
    }
    .map-hotspot.is-active {
      background: rgba(201, 95, 58, 0.20);
      border-color: var(--color-coral);
      box-shadow:
        0 0 0 4px rgba(201, 95, 58, 0.20),
        0 0 24px 8px rgba(201, 95, 58, 0.45);
      animation: hotspot-pulse 1.6s ease-in-out infinite;
    }
    @keyframes hotspot-pulse {
      0%, 100% { transform: translate(-50%, -50%) scale(1); }
      50% { transform: translate(-50%, -50%) scale(1.22); }
    }
    @media (prefers-reduced-motion: reduce) {
      .map-hotspot.is-active { animation: none; }
    }

    .legend-list {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .legend-list li { list-style: none; }

    .legend-item {
      display: flex;
      align-items: flex-start;
      gap: 0.875rem;
      padding: 0.625rem 0.75rem;
      border-radius: 12px;
      border: 1px solid transparent;
      background: transparent;
      transition: background-color 180ms ease, border-color 180ms ease;
      cursor: pointer;
    }
    .legend-item:hover,
    .legend-item:focus-visible,
    .legend-item.is-active {
      background: var(--color-sand-soft);
      border-color: var(--color-line);
      outline: none;
    }
    .legend-item.is-active {
      background: color-mix(in srgb, var(--color-coral) 7%, white);
      border-color: color-mix(in srgb, var(--color-coral) 25%, transparent);
    }

    .legend-letter {
      flex-shrink: 0;
      width: 32px; height: 32px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: white;
      border: 1.5px solid var(--color-line);
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 14px;
      color: var(--color-sea-deep);
      transition: all 180ms ease;
    }
    .legend-item:hover .legend-letter,
    .legend-item:focus-visible .legend-letter,
    .legend-item.is-active .legend-letter {
      background: var(--color-coral);
      color: white;
      border-color: var(--color-coral);
    }

    .legend-name {
      display: block;
      font-weight: 600;
      color: var(--color-sea-deep);
      font-size: 14px;
      line-height: 1.35;
    }
    .legend-desc {
      display: block;
      font-size: 12.5px;
      color: var(--color-ink-mute);
      margin-top: 2px;
      line-height: 1.45;
    }
  </style>
</Layout>
