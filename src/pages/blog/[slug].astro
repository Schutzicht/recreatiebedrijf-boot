---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  const modules = import.meta.glob('../../content/blog/*.md', { eager: true });
  return Object.entries(modules).map(([path, mod]) => ({
    params: { slug: path.split('/').pop()!.replace('.md', '') },
    props: { post: mod },
  }));
}

const { post } = Astro.props as { post: any };
const { Content, frontmatter } = post;
const site = Astro.site ?? new URL('https://demo-recreatiebedrijf-boot.vercel.app');

const dateStr = new Date(frontmatter.date).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: frontmatter.title,
  description: frontmatter.description,
  image: new URL(frontmatter.image, site).href,
  datePublished: frontmatter.date,
  inLanguage: 'nl-NL',
  author: { '@type': 'Organization', name: 'Recreatiebedrijf Boot', url: site.href },
  publisher: { '@type': 'Organization', name: 'Recreatiebedrijf Boot', url: site.href },
  mainEntityOfPage: new URL(Astro.url.pathname, site).href,
};
---
<Layout title={frontmatter.title} description={frontmatter.description} ogImage={frontmatter.image} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <article>
    <section class="relative pt-28 sm:pt-32 lg:pt-36 pb-10 overflow-hidden bg-mesh-warm">
      <div class="container-x">
        <div class="max-w-3xl" data-reveal>
          <a href="/blog" class="inline-flex items-center gap-2 text-sm text-[var(--color-ink-mute)] hover:text-[var(--color-sea)] transition-colors mb-6">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3l-5 5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Alle artikelen
          </a>
          <span class="dateline mb-5">{dateStr} · Recreatiebedrijf Boot</span>
          <h1 class="heading-hero text-balance">{frontmatter.title}</h1>
          <p class="mt-5 text-base sm:text-lg text-[var(--color-ink-soft)] max-w-2xl text-pretty leading-relaxed">{frontmatter.description}</p>
        </div>
      </div>
    </section>

    <section class="pb-6">
      <div class="container-x">
        <figure class="rounded-[1.75rem] overflow-hidden bg-[var(--color-mist)] shadow-[0_50px_90px_-40px_rgba(20,57,69,0.5)] aspect-[16/7]" data-reveal>
          <img src={frontmatter.image} alt={frontmatter.imageAlt ?? frontmatter.title} class="w-full h-full object-cover" />
        </figure>
      </div>
    </section>

    <section class="section pt-10">
      <div class="container-x">
        <div class="prose-boot max-w-3xl mx-auto" data-reveal>
          <Content />
        </div>
      </div>
    </section>
  </article>
</Layout>

<style is:global>
  .prose-boot {
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .prose-boot h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    color: var(--color-ink);
    margin-top: 2.5rem;
    margin-bottom: 0.875rem;
    letter-spacing: -0.016em;
  }
  .prose-boot h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1875rem;
    color: var(--color-ink);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .prose-boot p { margin-bottom: 1.125rem; }
  .prose-boot a {
    color: var(--color-sea);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-sea) 35%, transparent);
    text-underline-offset: 3px;
    transition: text-decoration-color 160ms ease;
  }
  .prose-boot a:hover { text-decoration-color: var(--color-sea); }
  .prose-boot ul, .prose-boot ol { margin: 0 0 1.125rem 1.25rem; }
  .prose-boot ul { list-style: disc; }
  .prose-boot ol { list-style: decimal; }
  .prose-boot li { margin-bottom: 0.375rem; padding-left: 0.25rem; }
  .prose-boot strong { color: var(--color-ink); font-weight: 600; }
  .prose-boot img { border-radius: 1rem; margin: 1.5rem 0; }
  .prose-boot blockquote {
    border-left: 3px solid var(--color-coral);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-ink);
  }
</style>
