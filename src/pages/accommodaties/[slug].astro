---
import Layout from '../../layouts/Layout.astro';
import { accommodations } from '../../data/site';

export function getStaticPaths() {
  return accommodations.map(a => ({ params: { slug: a.slug }, props: { acc: a } }));
}

const { acc } = Astro.props;
const others = accommodations.filter(a => a.slug !== acc.slug).slice(0, 3);
---
<Layout title={acc.name} description={acc.short}>

  <section class="relative pt-28 lg:pt-32 pb-0 overflow-hidden">
    <div class="container-x">
      <div class="grid lg:grid-cols-12 gap-10 items-end">
        <div class="lg:col-span-6 pb-10 lg:pb-16" data-reveal>
          <a href="/accommodaties" class="inline-flex items-center gap-2 text-sm text-[var(--color-ink-mute)] hover:text-[var(--color-sea)] transition-colors mb-6">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 3l-5 5 5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Alle accommodaties
          </a>
          <span class="eyebrow eyebrow-dark mb-4">{acc.eyebrow}</span>
          <h1 class="text-[2.4rem] sm:text-5xl lg:text-6xl text-balance leading-[1.04]">{acc.name}</h1>
          <p class="mt-5 text-lg text-[var(--color-ink-soft)] text-pretty max-w-xl">{acc.short}</p>
          <div class="mt-7 flex flex-wrap gap-2">
            {acc.badges.map(b => <span class="chip chip-sand">{b}</span>)}
          </div>

          <div class="mt-8 grid grid-cols-3 gap-4 max-w-md">
            <div>
              <div class="text-[11px] uppercase tracking-wider font-semibold text-[var(--color-ink-mute)]">Capaciteit</div>
              <div class="text-base font-semibold text-[var(--color-sea-deep)] mt-1">{acc.capacity}</div>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-wider font-semibold text-[var(--color-ink-mute)]">Maat</div>
              <div class="text-base font-semibold text-[var(--color-sea-deep)] mt-1">{acc.sizeRange}</div>
            </div>
            <div>
              <div class="text-[11px] uppercase tracking-wider font-semibold text-[var(--color-ink-mute)]">Prijs</div>
              <div class="text-base font-semibold text-[var(--color-coral)] mt-1">{acc.priceFrom}</div>
            </div>
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/reserveren" class="btn btn-coral">Reserveer dit verblijf</a>
            <a href="/contact" class="btn btn-outline">Stel een vraag</a>
          </div>
        </div>

        <div class="lg:col-span-6" data-reveal>
          <div class="polaroid rotate-right max-w-full">
            <div class="polaroid-img aspect-[4/3] lg:aspect-[5/4]">
              <img src={acc.image} alt={acc.name} loading="lazy"/>
            </div>
            <div class="polaroid-caption">{acc.eyebrow}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <div class="grid lg:grid-cols-12 gap-12">
        <div class="lg:col-span-7" data-reveal>
          <span class="eyebrow mb-4">Wat je kunt verwachten</span>
          <h2 class="text-3xl lg:text-4xl text-balance">Over {acc.name.toLowerCase()}.</h2>
          <p class="mt-5 text-[var(--color-ink-soft)] text-lg leading-relaxed text-pretty">{acc.description}</p>

          <h3 class="text-xl font-display mt-10 mb-4">Voorzieningen</h3>
          <ul class="space-y-3">
            {acc.facilities.map((f: string) => (
              <li class="flex items-start gap-3 text-[15px] text-[var(--color-ink-soft)]">
                <span class="mt-2 w-1.5 h-1.5 rounded-full bg-[var(--color-coral)] shrink-0"></span>
                <span>{f}</span>
              </li>
            ))}
          </ul>

          {acc.pets && (
            <div class="mt-8 p-5 rounded-2xl bg-[var(--color-mist)] border border-[var(--color-mist-deep)]">
              <div class="flex items-start gap-3">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="shrink-0 mt-0.5">
                  <circle cx="6" cy="9" r="2" fill="var(--color-sea)"/>
                  <circle cx="12" cy="6" r="2" fill="var(--color-sea)"/>
                  <circle cx="18" cy="9" r="2" fill="var(--color-sea)"/>
                  <path d="M9 14c0-3 1.5-4 3-4s3 1 3 4c0 2-1 3-3 3s-3-1-3-3z" fill="var(--color-sea)"/>
                </svg>
                <div>
                  <div class="text-sm font-semibold text-[var(--color-sea-deep)]">Honden</div>
                  <div class="text-sm text-[var(--color-ink-soft)] mt-1">{acc.pets}</div>
                </div>
              </div>
            </div>
          )}
        </div>

        <aside class="lg:col-span-5" data-reveal>
          <div class="lg:sticky lg:top-28">
            <div class="card card-elev p-7">
              <div class="text-xs uppercase tracking-wider font-semibold text-[var(--color-coral)]">Reserveer</div>
              <div class="mt-1 flex items-baseline gap-2">
                <div class="text-3xl font-display font-medium text-[var(--color-sea-deep)]">{acc.priceFrom}</div>
              </div>
              <p class="mt-3 text-sm text-[var(--color-ink-mute)]">
                In de demo tonen we de boekingsflow nog niet. In de live versie komt hier de directe beschikbaarheidskalender.
              </p>
              <a href="/reserveren" class="btn btn-coral w-full mt-5">Bekijk beschikbaarheid</a>
              <a href="/contact" class="btn btn-outline w-full mt-2">Stel een vraag</a>

              <div class="mt-6 pt-6 border-t border-[var(--color-line-soft)] space-y-3 text-sm">
                <div class="flex items-start gap-3">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mt-0.5 shrink-0"><path d="M2 5h12v8H2z" stroke="var(--color-sea)" stroke-width="1.4"/><path d="M5 3v3M11 3v3M2 8h12" stroke="var(--color-sea)" stroke-width="1.4" stroke-linecap="round"/></svg>
                  <span class="text-[var(--color-ink-soft)]">Min. 2 nachten · 7 nachten in vakantieperiodes</span>
                </div>
                <div class="flex items-start gap-3">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mt-0.5 shrink-0"><circle cx="8" cy="8" r="6" stroke="var(--color-sea)" stroke-width="1.4"/><path d="M8 5v3l2 1.5" stroke="var(--color-sea)" stroke-width="1.4" stroke-linecap="round"/></svg>
                  <span class="text-[var(--color-ink-soft)]">Inchecken vanaf 15:00, uitchecken voor 10:00</span>
                </div>
                <div class="flex items-start gap-3">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mt-0.5 shrink-0"><path d="M8 1v14M1 8h14" stroke="var(--color-sea)" stroke-width="1.4" stroke-linecap="round"/></svg>
                  <span class="text-[var(--color-ink-soft)]">Toeristenbelasting € 2,06 p.p. per nacht</span>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--color-sand-soft)] border-y border-[var(--color-line)]">
    <div class="container-x">
      <div class="flex items-end justify-between mb-10">
        <div>
          <span class="eyebrow mb-3">Andere verblijven</span>
          <h2 class="text-3xl lg:text-4xl">Misschien past dit ook bij je.</h2>
        </div>
        <a href="/accommodaties" class="hidden sm:inline-flex btn btn-outline">Alle accommodaties</a>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {others.map(a => (
          <a href={`/accommodaties/${a.slug}`} class="card card-hover p-0 overflow-hidden group">
            <div class="aspect-[4/3] img-zoom bg-[var(--color-mist)]">
              <img src={a.image} alt={a.name} loading="lazy"/>
            </div>
            <div class="p-5">
              <div class="text-xs uppercase tracking-wider font-semibold text-[var(--color-coral)]">{a.eyebrow}</div>
              <h3 class="text-xl font-display mt-1.5">{a.name}</h3>
              <p class="mt-2 text-sm text-[var(--color-ink-soft)] truncate-2">{a.short}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
